# SMTP settings used by Nodemailer to deliver consultation form submissions.
# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project Settings > Environment Variables
# (tick Production), enter values without quotes, and redeploy.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<the Gmail address>,
# SMTP_PASS=<a 16-character app password>, not the account password. App passwords
# need 2-Step Verification: https://myaccount.google.com/apppasswords
# Gmail sends as SMTP_USER unless CONSULTATION_FROM_EMAIL is a verified "Send mail as" alias.
SMTP_HOST=smtp.example.com
# 465 uses TLS from the start; 587 upgrades with STARTTLS
SMTP_PORT=465
SMTP_USER=website@beyondborders.ph
SMTP_PASS=your-smtp-password
# Where new requests are sent (comma-separate multiple addresses)
CONSULTATION_TO_EMAIL=info@beyondborders.ph
# Sender address; most SMTP providers require it to match SMTP_USER or a verified domain
CONSULTATION_FROM_EMAIL=Beyond Borders Website <website@beyondborders.ph>
NODE_ENV=